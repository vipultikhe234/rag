# Copy this file to `.env` (in the repository root) and replace every placeholder.
# `.env` is git-ignored. Use plain KEY=value lines without quotes.
# The backend imports this file automatically; docker compose and Vite read it too.

# ---------------------------------------------------------------------------
# PostgreSQL + pgvector (used by docker-compose.yml and the backend)
# ---------------------------------------------------------------------------
DB_NAME=product_rag
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/product_rag
DB_USERNAME=product_rag
DB_PASSWORD=replace-with-a-strong-database-password
DB_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# At least 32 bytes. Generate one with e.g.:
#   PowerShell: $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   bash:       openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION=PT8H

# Initial admin account, created on first start only if it does not exist yet.
# Password must be at least 12 characters. Leave empty to skip bootstrapping.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
ADMIN_DISPLAY_NAME=Administrator

# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# OpenAI (embeddings + chat)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector column dimension created by Flyway (see docs/vector-sync.md).
# text-embedding-3-small: 1536 (default), text-embedding-3-large: 3072 natively, may be reduced to <= 2000 for HNSW.
EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Leave empty for models that only accept the default temperature (e.g. reasoning models).
OPENAI_CHAT_TEMPERATURE=0.2
AI_CONNECT_TIMEOUT=PT10S
AI_READ_TIMEOUT=PT60S

# Free local alternative: Ollama (https://ollama.com) through its OpenAI-compatible API.
#   ollama pull nomic-embed-text && ollama pull llama3.2:3b
# then use these values instead (Ollama ignores the key, but it must not be empty):
#OPENAI_API_KEY=ollama
#OPENAI_BASE_URL=http://localhost:11434
#OPENAI_EMBEDDING_MODEL=nomic-embed-text
#EMBEDDING_DIMENSIONS=768
#OPENAI_CHAT_MODEL=llama3.2:3b
#AI_READ_TIMEOUT=PT180S
#VITE_API_TIMEOUT_MS=300000
# nomic-embed-text scores unrelated text much higher than OpenAI models (up to ~0.46 on the sample catalog):
#RAG_SIMILARITY_THRESHOLD=0.5

# ---------------------------------------------------------------------------
# Retrieval (RAG)
# ---------------------------------------------------------------------------
RAG_RETRIEVAL_LIMIT=5
# Cosine similarity in [0,1]; results below this are ignored. Tune for your embedding model.
RAG_SIMILARITY_THRESHOLD=0.25
# Semantic matches scoring more than this below the best match are left out of the prompt (0 disables).
# Keeps near-misses away from small local models, which otherwise treat every listed product as relevant.
RAG_RELATIVE_SCORE_MARGIN=0.1
RAG_STRUCTURED_RESULT_LIMIT=20

# ---------------------------------------------------------------------------
# Vector synchronization worker (transactional outbox)
# ---------------------------------------------------------------------------
VECTOR_SYNC_ENABLED=true
VECTOR_SYNC_POLL_INTERVAL=PT5S
VECTOR_SYNC_BATCH_SIZE=10
VECTOR_SYNC_MAX_ATTEMPTS=6
VECTOR_SYNC_INITIAL_BACKOFF=PT10S
VECTOR_SYNC_MAX_BACKOFF=PT15M
VECTOR_SYNC_STALE_TIMEOUT=PT5M

# ---------------------------------------------------------------------------
# Rate limiting (per instance, in-memory)
# ---------------------------------------------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=20

# ---------------------------------------------------------------------------
# Frontend (only VITE_* variables are exposed to the browser - never put secrets here)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
# Browser request timeout in ms (default 90000); keep it above AI_READ_TIMEOUT.
VITE_API_TIMEOUT_MS=90000
# Backend address used by the Vite dev-server proxy.
VITE_DEV_PROXY_TARGET=http://localhost:8080
